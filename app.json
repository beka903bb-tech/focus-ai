{
  "expo": {
    "name": "Focus AI",
    "slug": "focus-ai-stitch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "focusai",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F9FC",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Fokus sessiyasi davomida telefon yuztuban turganini aniqlash uchun harakat sensoridan foydalaniladi."
      }
    },
    "android": {
      "package": "com.focusai.habittracker",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0D1526",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F7F9FC"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Odat uchun rasm tanlash uchun galereyangizga kirish kerak.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b51de749-b00b-4051-a90a-10b7f47c6d19"
      }
    },
    "owner": "bekzod1984"
  }
}
